# Secrets -- never commit these
backend/.env
bot/.env

# Python virtual environment and caches
backend/.venv/
bot/.venv/
**/__pycache__/
*.pyc

# The local database lives outside this folder (see backend/app/config.py),
# but ignore it here too in case that ever changes.
*.db

# PyInstaller build output for the frozen backend (backend.spec) -- these
# are huge (bundle the whole interpreter + deps) and fully reproducible
# from run_backend.py + backend.spec, which ARE tracked.
backend/build/
backend/dist/

# macOS clutter
.DS_Store

# desktop/ has its own .gitignore for node_modules, dist, out, etc.
