# Copy this to ".env" (no ".example") if you want to override any defaults.
# Everything below is optional -- config.py's defaults work out of the box.

# SQLAlchemy connection string. Defaults to a SQLite file in
# ~/Library/Application Support/inventory-tracker/app.db -- deliberately
# NOT inside this (iCloud-synced) project folder. See config.py for why.
# DATABASE_URL=sqlite:////Users/you/Library/Application Support/inventory-tracker/app.db

# API_HOST=127.0.0.1
# API_PORT=8000
